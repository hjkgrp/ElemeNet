#!/usr/bin/env python3
from elemenet.training import training_pipeline
import yaml
import argparse
from pathlib import Path

if __name__ == "__main__":
    
    p = argparse.ArgumentParser(description='Training Script')
    p.add_argument('--config', type=Path, help='Path to YAML config file with training parameters')
    p.add_argument('--resume', type=Path, default=None, help='Path to run directory or checkpoint file to resume from')
    p.add_argument('--transfer_learn', type=Path, default=None, help='Path to a pretrained checkpoint to transfer-learn from (loads weights only, fresh optimizer)')
    
    args = p.parse_args()
    
    if args.config.is_file():
        with open(args.config, 'r') as f:
            config = yaml.safe_load(f)
    else:
        raise ValueError(f'Could not find config file at the specified path {args.config}')
    
    seed_state_dict_path = None
    seed_optimizer_state_path = None
    
    if args.resume is not None:
        # determine if we are resuming from a run directory or a checkpoint file
        if args.resume.is_dir():
            # we are resuming from a run directory
            # get the config file from the run directory
            run_dir = args.resume
            seed_state_dict_path = str(run_dir / 'checkpoints' / 'last.pt')
            seed_optimizer_state_path = str(run_dir / 'checkpoints' / 'last.pt')
            config["save_dir"] = str(run_dir)
        elif args.resume.is_file():
            config["save_dir"] = str(args.resume.parent.parent)
            seed_state_dict_path = str(args.resume)
            seed_optimizer_state_path = str(args.resume)
        else:
            raise ValueError('resume argument must be a run directory or a checkpoint file that must already exist')
        
    
    if args.transfer_learn is not None:
        assert args.resume is None, "Cannot specify both --resume and --transfer_learn arguments"
        if not args.transfer_learn.is_file():
            raise ValueError('transfer_learn argument must be a checkpoint file that must already exist')
        seed_state_dict_path = str(args.transfer_learn)
        seed_optimizer_state_path = None
        
    # Remove seed path keys from config so the CLI arguments take precedence
    # (config.yaml always contains these keys from the original training run,
    # which would cause a "multiple values for keyword argument" TypeError)
    config.pop("seed_model_state_path", None)
    config.pop("seed_optimizer_state_path", None)

    # Call training pipeline with the config parameters and seed model/optimizer paths
    training_pipeline(
        **config,
        seed_model_state_path=seed_state_dict_path,
        seed_optimizer_state_path=seed_optimizer_state_path
    )